MIGRATION_DATABASE_URL=
DATABASE_SSL=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
IP_HASH_SECRET=
LOG_LEVEL=info
DATABASE_SSL_CA_FILE=certs/supabase-ca.crt
